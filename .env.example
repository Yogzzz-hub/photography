# ==============================================================================
# MYORB FAMILY VAULT - ENVIRONMENT CONFIGURATION
# Zero credentials committed. All client values are public; server keys are kept in Workers.
# ==============================================================================

# Client Public Variables (Cloudflare Pages)
VITE_APP_TITLE="MyOrb Family Vault"
VITE_MAP_PROVIDER="openfreemap"
VITE_MAP_STYLE_DARK="https://tiles.openfreemap.org/styles/dark"
VITE_MAP_STYLE_LIBERTY="https://tiles.openfreemap.org/styles/liberty"

# Cloudflare Pages / Worker Gateway
VITE_STORAGE_GATEWAY_URL="https://storage-gateway.myorb.workers.dev"

# Supabase Auth & PostgreSQL (Free Tier)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Server / Worker Secrets (Never exposed to client bundles)
# CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
# CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_BUCKET_NAME="myorb-family-vault-media"
